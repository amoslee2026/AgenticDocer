#!/usr/bin/env bash
# 弹性安装 cweijan.vscode-office：代理闪断环境下循环重试 + 断点续传
set -uo pipefail
PX="http://172.17.220.111:7898"
OUT=/tmp/vscode-office.vsix
log() { echo "[$(date +%H:%M:%S)] $*"; }

ver=""
for i in $(seq 1 10); do
  ver="$(curl -sSL -x "$PX" --compressed --max-time 60 \
    "https://marketplace.visualstudio.com/items?itemName=cweijan.vscode-office" 2>/dev/null \


    | jq -r '.results[0].extensions[0].versions[0].version // empty')"
  [ -n "$ver" ] && break
  log "版本查询失败 attempt=$i，30s 后重试"; sleep 30
done
[ -z "$ver" ] && { log "FATAL: 版本查询 10 次全败"; exit 1; }
log "最新版本: $ver"

url="https://marketplace.visualstudio.com/_apis/public/gallery/publishers/cweijan/vsextensions/vscode-office/$ver/vspackage"
ok=0
for i in $(seq 1 30); do
  # vspackage 返回 gzip 压缩响应，--compressed 解出原始 vsix(zip)；-C - 断点续传
  if curl -sS -L -x "$PX" --compressed -C - --max-time 240 --retry 2 -o "$OUT" "$url" 2>/dev/null; then ok=1; break; fi
  log "下载中断 attempt=$i，30s 后续传"; sleep 30
done
[ "$ok" = 1 ] || { log "FATAL: 下载 30 次未完成"; exit 1; }
log "下载完成 $(stat -c%s "$OUT") bytes"
head -c2 "$OUT" | grep -q PK || { log "FATAL: 内容非 zip（vsix 损坏）"; exit 1; }

code --install-extension "$OUT" || exit 1
code --list-extensions
log "SUCCESS"
